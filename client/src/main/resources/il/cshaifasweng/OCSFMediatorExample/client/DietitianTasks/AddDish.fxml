<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.AddDishController">

    <VBox layoutX="8.0" layoutY="8.0" spacing="10" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
        <Label style="-fx-font-size: 16px;" text="Add New Dish" />

        <TextField fx:id="nameField" promptText="Dish Name" />
        <TextField fx:id="ingredientsField" promptText="Ingredients" />
        <TextField fx:id="PrefrencesField" promptText="Preferences" />

        <HBox spacing="10">
            <Label text="Dish Type:" />
            <RadioButton fx:id="ChainDishRdioId" selected="true" text="Chain Dish" />
        </HBox>

        <HBox spacing="10">
            <Label text="Delivery Available:" />
            <RadioButton fx:id="DeliveryRdaioId" text="Yes" />
        </HBox>

        <VBox fx:id="branchSelectionBox" spacing="5" visible="false">
            <!-- Branch checkboxes will be added here dynamically -->
        </VBox>

        <TextField fx:id="priceField" promptText="Price" />

        <Button onAction="#onSaveClicked" text="Save" />
    </VBox>
</AnchorPane>
