<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500" prefWidth="700" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.DietitianController">

    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Dietitian Menu Management" />

        <TableView fx:id="dishTable" prefHeight="300">
            <columns>
                <TableColumn fx:id="colId" prefWidth="49.60000264644623" text="Dish ID" />
                <TableColumn fx:id="colName" prefWidth="86.40003967285156" text="Dish Name" />
                <TableColumn fx:id="colIngredients" prefWidth="114.4000244140625" text="Ingredients" />
                <TableColumn fx:id="colPreferences" prefWidth="99.199951171875" text="Preferences" />
                <TableColumn fx:id="colChainDish" prefWidth="110.4000244140625" text="ChainDish" />
                <TableColumn fx:id="colBranchDish" prefWidth="93.5999755859375" text="BranchDish" />
                <TableColumn fx:id="colDelivery" prefWidth="187.199951171875" text="Delivery" />
                <TableColumn fx:id="colPrice" prefWidth="80" text="Price" />
                <TableColumn fx:id="colimg" prefWidth="100" text="Image" />
            </columns>
        </TableView>

        <HBox spacing="10">
            <Button onAction="#onAddDish" text="Add Dish" />
            <Button onAction="#onEditDish" text="Edit Selected" />
            <Button fx:id="removeDishButton" onAction="#onRemoveDish" text="Remove Selected" />
        </HBox>

        <HBox spacing="10">
            <Button onAction="#onConvertDishType" text="Convert Type" />
            <Button onAction="#onUpdatePrice" text="Update Price" />
            <Button onAction="#onLogout" text="Logout" />
        </HBox>

    </VBox>
</AnchorPane>