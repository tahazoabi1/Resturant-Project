<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="15" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.ReportController">

    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Monthly Report" />

    <ComboBox fx:id="branchSelector" promptText="Select Branch" />

    <Label fx:id="monthlyDeliveriesLabel" style="-fx-font-size: 16; -fx-font-weight: bold;" text="Deliveries This Month: Loading..."/>

    <TableView fx:id="dailyVisitTable" prefHeight="300" prefWidth="500">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="250"/>
            <TableColumn fx:id="visitorCountColumn" text="Visitor Count" prefWidth="250"/>
        </columns>
    </TableView>
    <BarChart fx:id="complaintStatusChart" title="Complaints Status This Month" prefHeight="300" prefWidth="500" visible="false">
        <xAxis>
            <CategoryAxis label="Complaint Status"/>
        </xAxis>
        <yAxis>
            <NumberAxis label="Count" autoRanging="true"/>
        </yAxis>
    </BarChart>


    <Button fx:id="allBranchesButton" text="Show All Branches Complaints Report" onAction="#loadAllBranchesReport"/>

    <Button onAction="#goBack" text="Back" />

</VBox>

<!-- works-->